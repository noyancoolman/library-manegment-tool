    def sort_books(self, choice):
        if self.sort_by.get() == "ABC":
            self.books = sorted(self.books, key=lambda book: book["name"])
        elif self.sort_by.get() == "ID":
            self.books = sorted(self.books, key=lambda book: int(book["id"]))
        elif self.sort_by.get() == "Year":
            try:
                self.books = sorted(
                self.books,
                key=lambda book: int(book["year"])
            )
            except ValueError:
                messagebox.showwarning(
                "Invalid year",
                "One or more of the book's years has a word btw."
            )
        self.show_books()
    
