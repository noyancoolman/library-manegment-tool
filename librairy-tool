    def search_books(self, *args):
        search = self.search_text.get().lower()
        search_by = self.search_by.get()

        if search_by == "Name":
            search_field = "name"

        elif search_by == "Genre":
            search_field = "genre"

        elif search_by == "Author":
            search_field = "author"

        filtered_books = []

        for book in self.books:
            if search in book[search_field].lower():
                filtered_books.append(book)

        self.show_searched_books(filtered_books)
