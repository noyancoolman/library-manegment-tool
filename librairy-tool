    def change_status(self, book):
        if book["status"] == "avalable":
            book["status"] = "borrowed"
        elif book["status"] == "borrowed":
            book["status"] = "avalable"
        self.save_books()
        self.quick_access()
        self.show_books()
    def change_stock(self, book):
        if book["status"] == "avalable" or book["status"] == "borrowed":
            book["status"] = "out of stock"
        elif book["status"] == "out of stock":
            book["status"] = "avalable"
        self.save_books()
        self.show_books()
    def delete_book(self, book):
        answer = messagebox.askyesno(
        "Delete book",
        "Are you sure you want to delete this book?"
    )

        if answer:
            self.books.remove(book)
            self.save_books()
            self.quick_access()
            self.show_books()
            messagebox.showinfo(
                "Deleted book",
                "book deleted successfully."
            )
    def quick_access(self):
        total = len(self.books)
        avalable = 0
        borrowed= 0
        for book in self.books:
            if book["status"] == "avalable":
                avalable = avalable +1
            elif book["status"] == "borrowed":
                borrowed = borrowed +1
        self.total_label.config(text=f"Total books: {total}")
        self.avalable_label.config(text=f"Avalable books: {avalable}")
        self.borrowed_label.config(text=f"Borrowed books: {borrowed}")
